{
  "expo": {
    "name": "Bar Dice Games",
    "slug": "SixSimpleDice",
    "version": "2.2.8",
    "orientation": "portrait",
    "icon": "./assets/images/android/adaptive-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "owner": "20boyerd",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.20boyerd.SixSimpleDice",
      "icon": {
        "dark": "./assets/images/ios/dark-icon.png",
        "light": "./assets/images/ios/light-icon.png",
        "tinted": "./assets/images/ios/tinted-icon.png"
      }
    },
    "android": {
      "package": "com.boyerd.sixsimpledice",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android/adaptive-icon.png"
      },
      "icon": "./assets/images/android/adaptive-icon.png",
      "blockedPermissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash.png",
          "dark": {
            "image": "./assets/images/splash.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 200
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "f58c856d-8051-4ba3-925e-0e5da8d25920"
      }
    }
  }
}
